<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_powerbi_report_dashboard" model="ir.ui.view">
        <field name="name">powerbi.report.dashboard</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <form string="Tableau de bord Power BI" create="0" edit="0" delete="0">
                <sheet>
                    <div class="o_powerbi_container" style="background-color: #f9f9f9; padding: 10px;">
                        <iframe width="100%" height="800px" 
                                src="https://app.powerbi.com/reportEmbed?reportId=YOUR_REPORT_ID" 
                                frameborder="0" 
                                allowFullScreen="true">
                        </iframe>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_open_powerbi_dashboard" model="ir.actions.act_window">
        <field name="name">Analyses Power BI</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">main</field>
        <field name="view_id" ref="view_powerbi_report_dashboard"/>
    </record>

    <menuitem id="menu_powerbi_root" 
              name="Power BI" 
              web_icon="base,static/description/settings.png"
              sequence="10"/>

    <menuitem id="menu_powerbi_dashboard" 
              name="Tableaux de bord" 
              parent="menu_powerbi_root" 
              action="action_open_powerbi_dashboard"
              sequence="1"/>
</odoo>