<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_bi" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.powerbi.pro</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                
                <div class="app_settings_block" data-string="Power BI Pro" string="Power BI Pro" data-key="odoobiconnect">
                    
                    <h2>Security &amp; API Configuration</h2>
                    <div class="row mt16 o_settings_container" name="powerbi_auth_section">
                        
                        <div class="col-12 col-lg-6 o_setting_box" id="jwt_management">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Authentication Secret</span>
                                <div class="text-muted">
                                    Define your unique JWT secret to encrypt OData communications.
                                </div>
                                <div class="content-group mt8">
                                    <div class="d-flex align-items-center">
                                        <field name="jwt_secret" 
                                               password="True" 
                                               readonly="1" 
                                               force_save="1" 
                                               placeholder="Click generate to create a secret..."
                                               class="w-75 fw-bold"/>
                                        <button name="action_generate_jwt_secret" 
                                                type="object" 
                                                string="Rotate Key" 
                                                class="btn btn-secondary ms-2" 
                                                icon="fa-refresh"
                                                confirm="Warning: Rotating the secret will invalidate existing connections. Continue?"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box" id="connection_gateway">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">OData Gateway</span>
                                <div class="text-muted">
                                    Establish a direct secure tunnel to Power BI Desktop or Service.
                                </div>
                                <div class="mt16">
                                    <button name="action_connect_to_powerbi" 
                                            type="object" 
                                            string="Launch Power BI Connector" 
                                            class="btn btn-primary" 
                                            icon="fa-plug"/>
                                    <div class="text-muted mt-2">
                                        <i class="fa fa-info-circle me-1"/> 
                                        Generates a secure OData endpoint with embedded session tokens.
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <h2>System Status</h2>
                    <div class="row mt16 o_settings_container" name="bi_status_section">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Connector Version</span>
                                <div class="mt8">
                                    <span class="badge rounded-pill badge-info">v5.0.0 Pro Edition</span>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </xpath>
        </field>
    </record>
</odoo>