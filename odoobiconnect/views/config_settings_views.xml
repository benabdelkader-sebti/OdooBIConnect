<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_bi" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.powerbi.pro</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Power BI Pro" string="Power BI Pro" data-key="odoobiconnect">
                    
                    <h2>Power BI API Configuration</h2>
                    <div class="row mt16 o_settings_container">
                        
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Access Token</span>
                                <div class="text-muted">
                                    Generate token and copy it to Power BI Desktop.
                                </div>
                                <div class="content-group mt16">
                                    <field name="generated_access_token" 
                                           readonly="1" 
                                           class="font-weight-bold text-primary p-2 bg-light border" 
                                           style="width: 100%; word-break: break-all !important; display: block; min-height: 50px;"/>
                                    
                                    <div class="mt16">
                                        <button name="action_generate_jwt_secret" 
                                                type="object" 
                                                string="Generate New Token" 
                                                class="btn-primary" 
                                                icon="fa-refresh"/>
                                        <field name="jwt_secret" invisible="1"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Power BI Template</span>
                                <div class="text-muted">
                                    Download the pre-configured PBIT file.
                                </div>
                                <div class="mt16">
                                    <button name="action_connect_to_powerbi" 
                                            type="object" 
                                            string="Download .PBIT File" 
                                            class="btn-secondary" 
                                            icon="fa-download"/>
                                    <div class="text-muted mt-2">
                                        <i class="fa fa-info-circle"/> v5.0.0 Pro Edition
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>